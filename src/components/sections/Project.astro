---
import Container from "../shared/Container.astro";
import { resolveSkills } from "../../icons/iconsMapping";
import { render } from "astro:content";

const { project } = Astro.props;
const { data, slug } = project;
const { title, img, tags, repoUrl, demoUrl, inDevelopment } = data;
const { Content } = await render(project);

const skills = resolveSkills(tags);

const isEn = Astro.currentLocale === "en";
const backHref = isEn ? "/en/#projects" : "/#projects";
const backText = isEn ? "Back to projects" : "Volver a proyectos";
const devLabel = isEn ? "In development" : "En desarrollo";
const demoLabel = isEn ? "View live" : "Ver online";
---

<Container className="pb-20">
  <div class="mx-auto max-w-3xl">
  <div class="pt-24 md:pt-28">
    <a
      href={backHref}
      class="group inline-flex items-center gap-2 text-sm font-medium text-heading-3 transition hover:text-primary"
    >
      <iconify-icon
        icon="mdi:arrow-left"
        class="text-lg transition group-hover:-translate-x-0.5"></iconify-icon>
      {backText}
    </a>
  </div>

  <header class="mt-5">
    <div
      class="relative overflow-hidden rounded-3xl border border-box-border shadow-lg shadow-box-shadow"
    >
      <img
        src={`/projects/${img}`}
        alt={title}
        class="h-56 w-full object-cover sm:h-72 md:h-[22rem]"
        fetchpriority="high"
        decoding="async"
        transition:name={`img-${slug}`}
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"
      >
      </div>
      <div class="absolute inset-x-0 bottom-0 p-5 sm:p-8">
        {
          inDevelopment && (
            <span class="mb-3 inline-flex items-center gap-1.5 rounded-full bg-amber-500 px-3 py-1 text-xs font-semibold text-white">
              <span class="h-1.5 w-1.5 rounded-full bg-white" />
              {devLabel}
            </span>
          )
        }
        <h1
          class="font-display text-3xl font-bold text-white drop-shadow-md sm:text-4xl md:text-5xl"
          transition:name={`title-${slug}`}
        >
          {title}
        </h1>
      </div>
    </div>

    <div
      class="mt-6 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between"
    >
      {
        skills.length > 0 && (
          <div
            class="flex flex-wrap items-center gap-3 text-3xl"
            transition:name={`skills-${slug}`}
          >
            {skills.map((skill) =>
              skill.type === "image" ? (
                <img
                  src={skill.src}
                  alt={skill.alt}
                  title={skill.alt}
                  class="h-8 w-8"
                />
              ) : (
                <>
                  <iconify-icon
                    icon={skill.light}
                    class="block dark:hidden"
                    title={skill.alt}
                  />
                  <iconify-icon
                    icon={skill.dark}
                    class="hidden dark:block"
                    title={skill.alt}
                  />
                </>
              ),
            )}
          </div>
        )
      }

      <div class="flex flex-shrink-0 items-center gap-3">
        {
          demoUrl && (
            <a
              href={demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white transition hover:opacity-90"
              transition:name={`demo-${slug}`}
            >
              <iconify-icon icon="mdi:open-in-new" class="text-lg" />
              {demoLabel}
            </a>
          )
        }
        {
          repoUrl && (
            <a
              href={repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full border border-box-border bg-box-bg px-5 py-2.5 text-sm font-semibold text-heading-1 transition hover:border-primary"
              transition:name={`github-${slug}`}
            >
              <iconify-icon icon="mdi:github" class="text-lg" />
              GitHub
            </a>
          )
        }
      </div>
    </div>
  </header>

  <article
    class="prose prose-lg mt-12 max-w-none dark:prose-invert prose-headings:font-display prose-headings:tracking-tight prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-strong:text-heading-1 prose-li:marker:text-primary"
  >
    <Content />
  </article>
  </div>
</Container>
