---
import Container from "../shared/Container.astro";
import { getI18n } from "../../i18n";
const { currentLocale } = Astro;
const i18n = getI18n({ currentLocale });

// Cifras del bloque "by the numbers".
// `age` y `experience` se calculan en cliente por su `id`; el resto son
// valores fijos y mantenibles desde aquí.
const stats: { id?: string; value: string; label: string }[] = [
  { id: "age", value: "", label: i18n.intro.byNumber.age },
  { id: "experience", value: "", label: i18n.intro.byNumber.experience },
  { value: "9", label: i18n.intro.byNumber.personal },
  { value: "11+", label: i18n.intro.byNumber.profesional },
];
---

<section class="relative mt-12 md:mt-16">
  <Container>
    <div
      class="p-5 sm:p-6 py-6 sm:py-8 max-w-5xl mx-auto rounded-3xl bg-box-bg border border-box-border shadow-lg shadow-box-shadow divide-y sm:divide-y-0 sm:divide-x divide-box-border grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4"
    >
      {
        stats.map((stat, index) => (
          <div class="text-center mb-3 md:mb-0">
            <h2
              class:list={[
                "font-semibold text-xl sm:text-2xl md:text-4xl text-heading-1",
                index !== 0 && "mt-3 md:mt-0",
              ]}
              id={stat.id}
            >
              {stat.value}
            </h2>
            <p class="mt-2 text-heading-3">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </Container>
</section>

<script>
  document.addEventListener("astro:page-load", () => {
    const yearsSince = (from: Date) => {
      const now = new Date();
      let years = now.getFullYear() - from.getFullYear();
      const monthDiff = now.getMonth() - from.getMonth();
      if (monthDiff < 0 || (monthDiff === 0 && now.getDate() < from.getDate())) {
        years--;
      }
      return years;
    };

    const ageEl = document.getElementById("age");
    if (ageEl) ageEl.textContent = yearsSince(new Date("2001-12-14")).toString();

    const experienceEl = document.getElementById("experience");
    if (experienceEl)
      experienceEl.textContent = yearsSince(new Date("2023-03-01")).toString() + "+";
  });
</script>
