---
import Container from "../shared/Container.astro";

const year = new Date().getFullYear();

const socials = [
  { href: "https://github.com/CGLMaster", icon: "mdi:github", label: "GitHub" },
  { href: "mailto:carlos9gomezl@gmail.com", icon: "mdi:email", label: "Email" },
  {
    href: "https://www.linkedin.com/in/carlos-g%C3%B3mez-l%C3%B3pez-66536027a/",
    icon: "mdi:linkedin",
    label: "LinkedIn",
  },
];
---

<footer
  class="mt-20 border-t border-box-border bg-gradient-to-tr from-gray-100 to-gray-200 dark:from-gray-900 dark:to-transparent py-8"
>
  <Container className="flex flex-col gap-4 sm:flex-row items-center justify-between">
    <div class="flex items-center gap-3">
      <img src="/images/favicon.png" alt="" class="w-8 h-8" />
      <span class="font-semibold text-heading-1">Carlos Gómez López</span>
    </div>

    <p class="order-last text-sm text-heading-3 sm:order-none">
      © {year} Carlos Gómez López
    </p>

    <div class="flex items-center gap-4 text-2xl text-heading-3">
      {
        socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            title={s.label}
            aria-label={s.label}
            class="transition hover:scale-110 hover:text-primary"
          >
            <iconify-icon icon={s.icon} />
          </a>
        ))
      }
    </div>
  </Container>
</footer>
