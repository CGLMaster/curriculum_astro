---
import { resolveSkills } from "../../icons/iconsMapping";

interface Props {
    slug: string;
    title: string;
    description: string;
    img: string;
    tags?: string[];
    inDevelopment?: boolean;
}

const {
    slug,
    title,
    description,
    img,
    tags = [],
    inDevelopment = false,
} = Astro.props as Props;

const skills = resolveSkills(tags);

const isEn = Astro.currentLocale === "en";
const id = slug.replace(/^(es|en)\//, "");
const href = isEn ? `/en/project/${id}` : `/project/${id}`;
const devLabel = isEn ? "In development" : "En desarrollo";
---

<a
    href={href}
    class="group flex flex-col overflow-hidden rounded-2xl border border-box-border bg-box-bg shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl"
>
    <div class="relative aspect-video overflow-hidden">
        <img
            src={`/projects/${img}`}
            alt={`Imagen de ${title}`}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
            transition:name={`img-${slug}`}
        />
        {
            inDevelopment && (
                <span class="absolute right-3 top-3 inline-flex items-center gap-1.5 rounded-full bg-amber-500 px-2.5 py-1 text-xs font-semibold text-white shadow">
                    <span class="h-1.5 w-1.5 rounded-full bg-white" />
                    {devLabel}
                </span>
            )
        }
    </div>

    <div class="flex flex-1 flex-col gap-3 p-5">
        <h3
            class="font-display text-xl font-bold text-heading-1 transition group-hover:text-primary"
            transition:name={`title-${slug}`}
        >
            {title}
        </h3>
        <p class="line-clamp-2 text-sm text-heading-3">{description}</p>

        <div class="mt-auto flex flex-wrap items-center gap-2.5 pt-2 text-2xl">
            {
                skills.map((skill) =>
                    skill.type === "image" ? (
                        <img
                            src={skill.src}
                            alt={skill.alt}
                            title={skill.alt}
                            class="h-6 w-6"
                        />
                    ) : (
                        <>
                            <iconify-icon
                                icon={skill.light}
                                class="block dark:hidden"
                                title={skill.alt}
                            />
                            <iconify-icon
                                icon={skill.dark}
                                class="hidden dark:block"
                                title={skill.alt}
                            />
                        </>
                    ),
                )
            }
        </div>
    </div>
</a>
