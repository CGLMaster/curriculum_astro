---
import { resolveSkills } from "../../icons/iconsMapping";

interface Props {
    slug: string;
    title: string;
    description: string;
    img: string;
    tags?: string[];
    repoUrl?: string;
    demoUrl?: string;
    inDevelopment?: boolean;
}

const {
    slug,
    title,
    description,
    img,
    tags = [],
    repoUrl,
    demoUrl,
    inDevelopment = false,
} = Astro.props as Props;

const skills = resolveSkills(tags);

const isEn = Astro.currentLocale === "en";
const id = slug.replace(/^(es|en)\//, "");
const href = isEn ? `/en/project/${id}` : `/project/${id}`;
const viewLabel = isEn ? "View project" : "Ver proyecto";
const devLabel = isEn ? "In development" : "En desarrollo";
---

<article
    class="group grid overflow-hidden rounded-2xl border border-box-border bg-box-bg shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl md:grid-cols-2"
>
    <a
        href={href}
        class="relative block aspect-video overflow-hidden md:aspect-auto md:h-full"
    >
        <img
            src={`/projects/${img}`}
            alt={`Imagen de ${title}`}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
            transition:name={`img-${slug}`}
        />
        {
            inDevelopment && (
                <span class="absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-full bg-amber-500 px-2.5 py-1 text-xs font-semibold text-white shadow">
                    <span class="h-1.5 w-1.5 rounded-full bg-white" />
                    {devLabel}
                </span>
            )
        }
    </a>

    <div class="flex flex-col gap-4 p-6 md:p-8">
        <a href={href}>
            <h3
                class="font-display text-2xl font-bold text-heading-1 transition group-hover:text-primary"
                transition:name={`title-${slug}`}
            >
                {title}
            </h3>
        </a>
        <p class="line-clamp-3 text-heading-3">{description}</p>

        <div
            class="flex flex-wrap items-center gap-2.5 text-2xl md:text-3xl"
            transition:name={`skills-${slug}`}
        >
            {
                skills.map((skill) =>
                    skill.type === "image" ? (
                        <img
                            src={skill.src}
                            alt={skill.alt}
                            title={skill.alt}
                            class="h-7 w-7"
                        />
                    ) : (
                        <>
                            <iconify-icon
                                icon={skill.light}
                                class="block dark:hidden"
                                title={skill.alt}
                            />
                            <iconify-icon
                                icon={skill.dark}
                                class="hidden dark:block"
                                title={skill.alt}
                            />
                        </>
                    ),
                )
            }
        </div>

        <div class="mt-auto flex flex-wrap items-center gap-3 pt-2">
            <a
                href={href}
                class="inline-flex items-center gap-1.5 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white transition hover:opacity-90"
            >
                {viewLabel}
                <iconify-icon
                    icon="mdi:arrow-right"
                    class="text-base transition group-hover:translate-x-0.5"></iconify-icon>
            </a>
            {
                demoUrl && (
                    <a
                        href={demoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 rounded-full border border-box-border px-5 py-2.5 text-sm font-semibold text-heading-1 transition hover:border-primary"
                        transition:name={`demo-${slug}`}
                    >
                        <iconify-icon icon="mdi:open-in-new" class="text-base" />
                        Demo
                    </a>
                )
            }
            {
                repoUrl && (
                    <a
                        href={repoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 rounded-full border border-box-border px-5 py-2.5 text-sm font-semibold text-heading-1 transition hover:border-primary"
                        transition:name={`github-${slug}`}
                    >
                        <iconify-icon icon="mdi:github" class="text-base" />
                        GitHub
                    </a>
                )
            }
        </div>
    </div>
</article>
