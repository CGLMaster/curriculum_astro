---
import BaseHead from "../components/seo/BaseHead.astro";
import Navbar from "../components/elements/Navbar.astro";
import Footer from "../components/elements/Footer.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, image, jsonLd } = Astro.props;
const lang = Astro.currentLocale ?? "es";
---

<!doctype html>
<html lang={lang}>
  <BaseHead
    title={title}
    description={description}
    image={image}
    type="article"
    jsonLd={jsonLd}
  />
  <body class="bg-body">
    <Navbar />
    <slot />
    <Footer />
    <ClientRouter />
  </body>
</html>
