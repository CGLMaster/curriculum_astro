---
import { getCollection } from "astro:content";
import App from "../../../components/sections/Project.astro";
import ProjectLayout from "../../../layouts/ProjectLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  const englishProjects = projects.filter((project) =>
    project.slug.startsWith("en/"),
  );
  return englishProjects.map((project) => {
    const id = project.slug.replace(/^(es|en)\//, "");
    return {
      params: { id },
      props: { project },
    };
  });
}

const { project } = Astro.props;
const { title, description, img, demoUrl } = project.data;

const SITE = Astro.site ?? new URL("https://dev-cgl-portfolio.onrender.com");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: title,
  description,
  applicationCategory: "WebApplication",
  operatingSystem: "Web",
  image: new URL(`/projects/${img}`, SITE).href,
  author: { "@type": "Person", name: "Carlos Gómez López" },
  ...(demoUrl ? { url: demoUrl } : {}),
};
---

<ProjectLayout
  title={title}
  description={description}
  image={`/projects/${img}`}
  jsonLd={jsonLd}
>
  <App project={project} />
</ProjectLayout>
